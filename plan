## 🖼️ Parte 4: Imagens Transient + Imageless Framebuffer

```cpp
// ----------------------------------------------------------------------------
// Cria imagem transient (nunca toca VRAM principal no Mali!)
// ----------------------------------------------------------------------------
inline bool createTransientImage(VkDevice device, VkPhysicalDevice gpu,
                                  VkExtent2D extent, VkFormat format,
                                  VkSampleCountFlagBits samples,
                                  VkImageUsageFlags usage,
                                  VkImage& outImage, VkDeviceMemory& outMemory) {
    
    VkImageCreateInfo info{};
    info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
    info.imageType = VK_IMAGE_TYPE_2D;
    info.format = format;
    info.extent = {extent.width, extent.height, 1};
    info.mipLevels = 1;
    info.arrayLayers = 1;
    info.samples = samples;
    info.tiling = VK_IMAGE_TILING_OPTIMAL;
    info.usage = usage | VK_IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT;
    info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
    info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
    
    if (vkCreateImage(device, &info, nullptr, &outImage) != VK_SUCCESS) return false;
    
    VkMemoryRequirements reqs;
    vkGetImageMemoryRequirements(device, outImage, &reqs);
    
    // NO MALI: transient attachments devem usar LAZY ALLOCATION
    // A GPU só aloca memória física quando o tile é processado!
    VkMemoryAllocateInfo allocInfo{};
    allocInfo.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
    allocInfo.allocationSize = reqs.size;
    
    // Encontra memory type com LAZY_ALLOCATION_BIT (crucial para transient!)
    VkPhysicalDeviceMemoryProperties memProps;
    vkGetPhysicalDeviceMemoryProperties(gpu, &memProps);
    
    uint32_t memTypeIdx = UINT32_MAX;
    for (uint32_t i = 0; i < memProps.memoryTypeCount; i++) {
        if ((reqs.memoryTypeBits & (1 << i)) &&
            (memProps.memoryTypes[i].propertyFlags & 
             VK_MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT)) {
            memTypeIdx = i;
            break;
        }
    }
    
    // Fallback para device local se lazy não disponível
    if (memTypeIdx == UINT32_MAX) {
        for (uint32_t i = 0; i < memProps.memoryTypeCount; i++) {
            if ((reqs.memoryTypeBits & (1 << i)) &&
                (memProps.memoryTypes[i].propertyFlags & 
                 VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) {
                memTypeIdx = i;
                break;
            }
        }
    }
    
    allocInfo.memoryTypeIndex = memTypeIdx;
    
    if (vkAllocateMemory(device, &allocInfo, nullptr, &outMemory) != VK_SUCCESS) {
        vkDestroyImage(device, outImage, nullptr);
        return false;
    }
    
    vkBindImageMemory(device, outImage, outMemory, 0);
    return true;
}

// ----------------------------------------------------------------------------
// Cria Image View com Maintenance2 (usage restrito)
// Informa ao driver exatamente como será usado - permite otimizações agressivas
// ----------------------------------------------------------------------------
inline VkImageView createOptimizedImageView(VkDevice device, VkImage image,
                                             VkFormat format,
                                             VkImageAspectFlags aspect,
                                             VkImageUsageFlags restrictedUsage) {
    // VK_KHR_maintenance2: restringe o usage da view (driver otimiza mais)
    VkImageViewUsageCreateInfo usageInfo{};
    usageInfo.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_USAGE_CREATE_INFO;
    usageInfo.usage = restrictedUsage;
    
    VkImageViewCreateInfo viewInfo{};
    viewInfo.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
    viewInfo.pNext = &usageInfo;
    viewInfo.image = image;
    viewInfo.viewType = VK_IMAGE_VIEW_TYPE_2D;
    viewInfo.format = format;
    viewInfo.subresourceRange.aspectMask = aspect;
    viewInfo.subresourceRange.baseMipLevel = 0;
    viewInfo.subresourceRange.levelCount = 1;
    viewInfo.subresourceRange.baseArrayLayer = 0;
    viewInfo.subresourceRange.layerCount = 1;
    
    VkImageView view;
    vkCreateImageView(device, &viewInfo, nullptr, &view);
    return view;
}

// ----------------------------------------------------------------------------
// Cria Imageless Framebuffer (VK_KHR_imageless_framebuffer)
// UM FRAMEBUFFER para todas as swapchain images! (economia massiva de CPU)
// ----------------------------------------------------------------------------
inline VkFramebuffer createImagelessFramebuffer(VkDevice device,
                                                 VkRenderPass renderPass,
                                                 VkExtent2D extent,
                                                 const std::vector<VkFormat>& formats,
                                                 const std::vector<VkImageUsageFlags>& usages,
                                                 VkSampleCountFlagBits msaaSamples) {
    
    std::vector<VkFramebufferAttachmentImageInfo> attInfos(formats.size());
    for (size_t i = 0; i < formats.size(); i++) {
        attInfos[i].sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_ATTACHMENT_IMAGE_INFO;
        attInfos[i].pNext = nullptr;
        attInfos[i].flags = 0;
        attInfos[i].usage = usages[i];
        attInfos[i].width = extent.width;
        attInfos[i].height = extent.height;
        attInfos[i].layerCount = 1;
        attInfos[i].viewFormatCount = 1;
        attInfos[i].pViewFormats = &formats[i];
    }
    
    VkFramebufferAttachmentsCreateInfo attCreateInfo{};
    attCreateInfo.sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_ATTACHMENTS_CREATE_INFO;
    attCreateInfo.attachmentImageInfoCount = static_cast<uint32_t>(attInfos.size());
    attCreateInfo.pAttachmentImageInfos = attInfos.data();
    
    VkFramebufferCreateInfo fbInfo{};
    fbInfo.sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO;
    fbInfo.pNext = &attCreateInfo;
    fbInfo.flags = VK_FRAMEBUFFER_CREATE_IMAGELESS_BIT;  // A MÁGICA!
    fbInfo.renderPass = renderPass;
    fbInfo.attachmentCount = static_cast<uint32_t>(formats.size());
    fbInfo.pAttachments = nullptr;  // VAZIO! Views vêm no BeginRenderPass
    fbInfo.width = extent.width;
    fbInfo.height = extent.height;
    fbInfo.layers = 1;
    
    VkFramebuffer fb;
    vkCreateFramebuffer(device, &fbInfo, nullptr, &fb);
    return fb;
}
