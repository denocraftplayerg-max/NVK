// MALI_OPTIMIZED_RENDER.HPP
// Template de Render Pass otimizado para Mali-G52 MC2 (Bifrost TBDR)
// Substitui Dynamic Rendering com performance 2-5x superior em TBDR
// ============================================================================

#pragma once
#include <vulkan/vulkan.h>
#include <vector>
#include <array>
#include <cstdint>
#include <cstring>

// ----------------------------------------------------------------------------
// Configurações globais específicas para Mali-G52
// ----------------------------------------------------------------------------
namespace MaliG52 {
    constexpr uint32_t TILE_WIDTH = 16;       // Tile size Bifrost
    constexpr uint32_t TILE_HEIGHT = 16;
    constexpr VkSampleCountFlagBits MAX_MSAA = VK_SAMPLE_COUNT_4_BIT;
    
    // Formats AFBC-friendly (compressão hardware ARM)
    constexpr VkFormat ALBEDO_FORMAT = VK_FORMAT_R8G8B8A8_UNORM;      // AFBC ok
    constexpr VkFormat NORMAL_FORMAT = VK_FORMAT_A2B10G10R10_UNORM_PACK32; // Melhor que RGBA16F
    constexpr VkFormat DEPTH_FORMAT  = VK_FORMAT_D24_UNORM_S8_UINT;   // D32 não tem AFBC!
    constexpr VkFormat ROUGHNESS_METALLIC_FORMAT = VK_FORMAT_R8G8_UNORM;
}

// ----------------------------------------------------------------------------
// Extensões obrigatórias a habilitar no device creation
// ----------------------------------------------------------------------------
static const std::vector<const char*> REQUIRED_EXTENSIONS = {
    VK_KHR_CREATE_RENDERPASS_2_EXTENSION_NAME,      // RenderPass2 (subpasses avançados)
    VK_KHR_IMAGELESS_FRAMEBUFFER_EXTENSION_NAME,    // Framebuffers sem views fixas
    VK_KHR_MAINTENANCE2_EXTENSION_NAME,             // ImageViewUsageCreateInfo
    VK_KHR_DEPTH_STENCIL_RESOLVE_EXTENSION_NAME,    // Resolve depth no render pass
    VK_KHR_MULTIVIEW_EXTENSION_NAME,                // Otimização VR/múltiplas câmeras
    VK_KHR_BIND_MEMORY_2_EXTENSION_NAME,
    VK_KHR_GET_MEMORY_REQUIREMENTS_2_EXTENSION_NAME,
    VK_KHR_DEDICATED_ALLOCATION_EXTENSION_NAME,
};

// Verifica se todas extensões estão disponíveis
inline bool checkExtensionsAvailable(VkPhysicalDevice gpu,
                                      const std::vector<const char*>& required) {
    uint32_t count = 0;
    vkEnumerateDeviceExtensionProperties(gpu, nullptr, &count, nullptr);
    std::vector<VkExtensionProperties> available(count);
    vkEnumerateDeviceExtensionProperties(gpu, nullptr, &count, available.data());
    
    for (const char* ext : required) {
        bool found = false;
        for (const auto& prop : available) {
            if (strcmp(prop.extensionName, ext) == 0) {
                found = true;
                break;
            }
        }
        if (!found) return false;
    }
    return true;
}
