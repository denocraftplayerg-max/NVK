## 🎨 Parte 6: Shader de Lighting (Input Attachments)

```glsl
// lighting.frag - Otimizado para Mali Bifrost (pixel-local operations)
#version 450

layout(input_attachment_index = 0, set = 0, binding = 0) uniform subpassInput albedoInput;
layout(input_attachment_index = 1, set = 0, binding = 1) uniform subpassInput normalInput;
layout(input_attachment_index = 2, set = 0, binding = 2) uniform subpassInput roughMetalInput;
layout(input_attachment_index = 3, set = 0, binding = 3) uniform subpassInput colorInput;
layout(input_attachment_index = 4, set = 0, binding = 4) uniform subpassInput depthInput;

layout(location = 0) out vec4 outColor;

layout(push_constant) uniform PC {
    vec3 lightDir;
    vec3 lightColor;
    vec3 cameraPos;
} pc;

void main() {
    // subpassLoad lê DIRETO do tile buffer (ZERO bandwidth!)
    vec3 albedo = subpassLoad(albedoInput).rgb;
    vec3 normal = normalize(subpassLoad(normalInput).rgb * 2.0 - 1.0);
    vec2 rm = subpassLoad(roughMetalInput).rg;
    float depth = subpassLoad(depthInput).r;
    
    float NdotL = max(dot(normal, pc.lightDir), 0.0);
    vec3 lit = albedo * pc.lightColor * NdotL;
    
    outColor = vec4(lit, 1.0);
}
