## 🏗️ Parte 3: Criação do Render Pass (usando VK_KHR_create_renderpass2)

```cpp
// ----------------------------------------------------------------------------
// Criação do VkRenderPass com RenderPassCreateInfo2 (extensão)
// Otimizado para Mali Bifrost: subpasses + input attachments + depth resolve
// ----------------------------------------------------------------------------
inline VkRenderPass createOptimizedRenderPass(VkDevice device, 
                                               VkSampleCountFlagBits msaa) {
    
    // ========================================================================
    // ATTACHMENT DESCRIPTIONS (VkAttachmentDescription2)
    // ========================================================================
    std::array<VkAttachmentDescription2, static_cast<size_t>(GBufferAttachment::COUNT)> atts = {};
    
    auto makeAtt = [](VkFormat fmt, VkSampleCountFlagBits samples,
                      VkAttachmentLoadOp load, VkAttachmentStoreOp store,
                      VkImageLayout initLayout, VkImageLayout finalLayout) {
        VkAttachmentDescription2 a{};
        a.sType = VK_STRUCTURE_TYPE_ATTACHMENT_DESCRIPTION_2;
        a.format = fmt;
        a.samples = samples;
        a.loadOp = load;
        a.storeOp = store;
        a.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
        a.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
        a.initialLayout = initLayout;
        a.finalLayout = finalLayout;
        return a;
    };
    
    // MSAA attachments - TODOS transient (ficam só no tile buffer do Mali!)
    // storeOp = DONT_CARE (nunca escritos na VRAM)
    const VkImageLayout undef = VK_IMAGE_LAYOUT_UNDEFINED;
    const VkImageLayout colOpt = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
    const VkImageLayout dsOpt = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
    const VkImageLayout shRead = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
    const VkImageLayout dsRead = VK_IMAGE_LAYOUT_DEPTH_STENCIL_READ_ONLY_OPTIMAL;
    
    // [0] COLOR_MSAA - Transient, resolve no final do subpass
    atts[0] = makeAtt(VK_FORMAT_B8G8R8A8_UNORM, msaa,
                      VK_ATTACHMENT_LOAD_OP_CLEAR, VK_ATTACHMENT_STORE_OP_DONT_CARE,
                      undef, colOpt);
    
    // [1-3] G-Buffer MSAA transient
    atts[1] = makeAtt(MaliG52::ALBEDO_FORMAT, msaa,
                      VK_ATTACHMENT_LOAD_OP_CLEAR, VK_ATTACHMENT_STORE_OP_DONT_CARE,
                      undef, colOpt);
    atts[2] = makeAtt(MaliG52::NORMAL_FORMAT, msaa,
                      VK_ATTACHMENT_LOAD_OP_CLEAR, VK_ATTACHMENT_STORE_OP_DONT_CARE,
                      undef, colOpt);
    atts[3] = makeAtt(MaliG52::ROUGHNESS_METALLIC_FORMAT, msaa,
                      VK_ATTACHMENT_LOAD_OP_CLEAR, VK_ATTACHMENT_STORE_OP_DONT_CARE,
                      undef, colOpt);
    
    // [4] DEPTH_MSAA - resolve via depth_stencil_resolve extension
    atts[4] = makeAtt(MaliG52::DEPTH_FORMAT, msaa,
                      VK_ATTACHMENT_LOAD_OP_CLEAR, VK_ATTACHMENT_STORE_OP_DONT_CARE,
                      undef, dsOpt);
    
    // [5-9] Resolved attachments (1x, persistentes - lidas pelo lighting)
    atts[5] = makeAtt(VK_FORMAT_B8G8R8A8_UNORM, VK_SAMPLE_COUNT_1_BIT,
                      VK_ATTACHMENT_LOAD_OP_DONT_CARE, VK_ATTACHMENT_STORE_OP_STORE,
                      undef, shRead);
    atts[6] = makeAtt(MaliG52::ALBEDO_FORMAT, VK_SAMPLE_COUNT_1_BIT,
                      VK_ATTACHMENT_LOAD_OP_DONT_CARE, VK_ATTACHMENT_STORE_OP_STORE,
                      undef, shRead);
    atts[7] = makeAtt(MaliG52::NORMAL_FORMAT, VK_SAMPLE_COUNT_1_BIT,
                      VK_ATTACHMENT_LOAD_OP_DONT_CARE, VK_ATTACHMENT_STORE_OP_STORE,
                      undef, shRead);
    atts[8] = makeAtt(MaliG52::ROUGHNESS_METALLIC_FORMAT, VK_SAMPLE_COUNT_1_BIT,
                      VK_ATTACHMENT_LOAD_OP_DONT_CARE, VK_ATTACHMENT_STORE_OP_STORE,
                      undef, shRead);
    atts[9] = makeAtt(MaliG52::DEPTH_FORMAT, VK_SAMPLE_COUNT_1_BIT,
                      VK_ATTACHMENT_LOAD_OP_DONT_CARE, VK_ATTACHMENT_STORE_OP_STORE,
                      undef, dsRead);
    
    // [10] LIGHTING_OUTPUT - output do subpass de lighting
    atts[10] = makeAtt(VK_FORMAT_B8G8R8A8_UNORM, VK_SAMPLE_COUNT_1_BIT,
                       VK_ATTACHMENT_LOAD_OP_DONT_CARE, VK_ATTACHMENT_STORE_OP_STORE,
                       undef, shRead);
    
    // [11] SWAPCHAIN_FINAL
    atts[11] = makeAtt(VK_FORMAT_B8G8R8A8_UNORM, VK_SAMPLE_COUNT_1_BIT,
                       VK_ATTACHMENT_LOAD_OP_DONT_CARE, VK_ATTACHMENT_STORE_OP_STORE,
                       undef, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR);
    
    // ========================================================================
    // SUBPASS 0: Geometry (MSAA → Resolve)
    // ========================================================================
    std::array<VkAttachmentReference2, 4> sub0Colors = {};
    auto makeRef = [](uint32_t att, VkImageLayout layout) {
        VkAttachmentReference2 r{};
        r.sType = VK_STRUCTURE_TYPE_ATTACHMENT_REFERENCE_2;
        r.attachment = att;
        r.layout = layout;
        r.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
        return r;
    };
    
    sub0Colors[0] = makeRef(0, colOpt);
    sub0Colors[1] = makeRef(1, colOpt);
    sub0Colors[2] = makeRef(2, colOpt);
    sub0Colors[3] = makeRef(3, colOpt);
    
    // Resolve attachments (MSAA → 1x, feito NO tile buffer do Mali!)
    std::array<VkAttachmentReference2, 4> sub0Resolves = {};
    sub0Resolves[0] = makeRef(5, colOpt);
    sub0Resolves[1] = makeRef(6, colOpt);
    sub0Resolves[2] = makeRef(7, colOpt);
    sub0Resolves[3] = makeRef(8, colOpt);
    
    // Depth attachment + depth resolve (via VK_KHR_depth_stencil_resolve)
    VkAttachmentReference2 sub0Depth{};
    sub0Depth.sType = VK_STRUCTURE_TYPE_ATTACHMENT_REFERENCE_2;
    sub0Depth.attachment = 4;
    sub0Depth.layout = dsOpt;
    sub0Depth.aspectMask = VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT;
    
    // EXTENSION MAGIC: resolve depth automaticamente no tile!
    VkAttachmentReference2 depthResolveRef{};
    depthResolveRef.sType = VK_STRUCTURE_TYPE_ATTACHMENT_REFERENCE_2;
    depthResolveRef.attachment = 9;
    depthResolveRef.layout = dsRead;
    depthResolveRef.aspectMask = VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT;
    
    VkSubpassDescriptionDepthStencilResolve depthResolve{};
    depthResolve.sType = VK_STRUCTURE_TYPE_SUBPASS_DESCRIPTION_DEPTH_STENCIL_RESOLVE;
    depthResolve.depthResolveMode = VK_RESOLVE_MODE_SAMPLE_ZERO_BIT;
    depthResolve.stencilResolveMode = VK_RESOLVE_MODE_SAMPLE_ZERO_BIT;
    depthResolve.pDepthStencilResolveAttachment = &depthResolveRef;
    
    VkSubpassDescription2 subpass0{};
    subpass0.sType = VK_STRUCTURE_TYPE_SUBPASS_DESCRIPTION_2;
    subpass0.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
    subpass0.colorAttachmentCount = 4;
    subpass0.pColorAttachments = sub0Colors.data();
    subpass0.pResolveAttachments = sub0Resolves.data();  // MSAA resolve!
    subpass0.pDepthStencilAttachment = &sub0Depth;
    subpass0.pNext = &depthResolve;  // Depth resolve!
    
    // ========================================================================
    // SUBPASS 1: Lighting (lê G-Buffer via Input Attachments)
    // NO Mali: dados ficam no tile buffer, ZERO bandwidth!
    // ========================================================================
    std::array<VkAttachmentReference2, 4> sub1Inputs = {};
    sub1Inputs[0] = makeRef(6, shRead);   // albedo
    sub1Inputs[1] = makeRef(7, shRead);   // normal
    sub1Inputs[2] = makeRef(8, shRead);   // roughness/metallic
    sub1Inputs[3] = makeRef(5, shRead);   // cor resolved (para emissive/fog)
    
    VkAttachmentReference2 sub1Color = makeRef(10, colOpt);
    VkAttachmentReference2 sub1DepthRead{};
    sub1DepthRead.sType = VK_STRUCTURE_TYPE_ATTACHMENT_REFERENCE_2;
    sub1DepthRead.attachment = 9;
    sub1DepthRead.layout = dsRead;
    sub1DepthRead.aspectMask = VK_IMAGE_ASPECT_DEPTH_BIT;
    
    VkSubpassDescription2 subpass1{};
    subpass1.sType = VK_STRUCTURE_TYPE_SUBPASS_DESCRIPTION_2;
    subpass1.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
    subpass1.inputAttachmentCount = 4;
    subpass1.pInputAttachments = sub1Inputs.data();
    subpass1.colorAttachmentCount = 1;
    subpass1.pColorAttachments = &sub1Color;
    subpass1.pDepthStencilAttachment = &sub1DepthRead;  // read-only depth
    
    // ========================================================================
    // SUBPASS 2: Post-Process (tonemap + output swapchain)
    // ========================================================================
    VkAttachmentReference2 sub2Input = makeRef(10, shRead);
    VkAttachmentReference2 sub2Color = makeRef(11, colOpt);
    
    VkSubpassDescription2 subpass2{};
    subpass2.sType = VK_STRUCTURE_TYPE_SUBPASS_DESCRIPTION_2;
    subpass2.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
    subpass2.inputAttachmentCount = 1;
    subpass2.pInputAttachments = &sub2Input;
    subpass2.colorAttachmentCount = 1;
    subpass2.pColorAttachments = &sub2Color;
    
    std::array<VkSubpassDescription2, 3> subpasses = {subpass0, subpass1, subpass2};
    
    // ========================================================================
    // SUBPASS DEPENDENCIES (CRÍTICO para Mali Bifrost!)
    // ========================================================================
    std::array<VkSubpassDependency2, 4> deps = {};
    
    auto makeDep = [](uint32_t src, uint32_t dst,
                      VkPipelineStageFlags srcStage, VkPipelineStageFlags dstStage,
                      VkAccessFlags srcAccess, VkAccessFlags dstAccess) {
        VkSubpassDependency2 d{};
        d.sType = VK_STRUCTURE_TYPE_SUBPASS_DEPENDENCY_2;
        d.srcSubpass = src;
        d.dstSubpass = dst;
        d.srcStageMask = srcStage;
        d.dstStageMask = dstStage;
        d.srcAccessMask = srcAccess;
        d.dstAccessMask = dstAccess;
        // BY_REGION_BIT é ESSENCIAL no Mali: permite que tiles sejam processados
        // independentemente, habilitando "pixel-local" operations
        d.dependencyFlags = VK_DEPENDENCY_BY_REGION_BIT;
        d.viewOffset = 0;
        return d;
    };
    
    // External → Subpass 0
    deps[0] = makeDep(VK_SUBPASS_EXTERNAL, 0,
        VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
        VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT |
        VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT,
        VK_ACCESS_MEMORY_READ_BIT,
        VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT |
        VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT);
    
    // Subpass 0 → Subpass 1 (resolve + input attachment read)
    deps[1] = makeDep(0, 1,
        VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT |
        VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT,
        VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT |
        VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT,
        VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT |
        VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT,
        VK_ACCESS_INPUT_ATTACHMENT_READ_BIT |
        VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT);
    
    // Subpass 1 → Subpass 2
    deps[2] = makeDep(1, 2,
        VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
        VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
        VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
        VK_ACCESS_INPUT_ATTACHMENT_READ_BIT);
    
    // Subpass 2 → External (para apresentação)
    deps[3] = makeDep(2, VK_SUBPASS_EXTERNAL,
        VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
        VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
        VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
        VK_ACCESS_MEMORY_READ_BIT);
    
    // ========================================================================
    // CREATE RENDER PASS (usando CreateRenderPass2)
    // ========================================================================
    VkRenderPassCreateInfo2 rpInfo{};
    rpInfo.sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO_2;
    rpInfo.attachmentCount = static_cast<uint32_t>(atts.size());
    rpInfo.pAttachments = atts.data();
    rpInfo.subpassCount = 3;
    rpInfo.pSubpasses = subpasses.data();
    rpInfo.dependencyCount = static_cast<uint32_t>(deps.size());
    rpInfo.pDependencies = deps.data();
    rpInfo.correlatedViewMaskCount = 0;
    rpInfo.pCorrelatedViewMasks = nullptr;
    
    VkRenderPass renderPass = VK_NULL_HANDLE;
    if (vkCreateRenderPass2(device, &rpInfo, nullptr, &renderPass) != VK_SUCCESS) {
        return VK_NULL_HANDLE;
    }
    return renderPass;
}
