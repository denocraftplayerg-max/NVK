package net.vulkanmod.vulkan.framebuffer;

import net.vulkanmod.vulkan.Renderer;
import net.vulkanmod.vulkan.VRenderSystem;
import net.vulkanmod.vulkan.Vulkan;
import net.vulkanmod.vulkan.memory.MemoryManager;
import org.lwjgl.system.MemoryStack;
import org.lwjgl.vulkan.*;

import java.nio.LongBuffer;

import static org.lwjgl.vulkan.KHRCreateRenderpass2.*;
import static org.lwjgl.vulkan.KHRDepthStencilResolve.*;
import static org.lwjgl.vulkan.KHRImagelessFramebuffer.*;
import static org.lwjgl.vulkan.KHRSwapchain.VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
import static org.lwjgl.vulkan.VK10.*;
import static org.lwjgl.vulkan.VK11.*;

public class RenderPass {
    Framebuffer framebuffer;
    long id;

    final int attachmentCount;
    AttachmentInfo colorAttachmentInfo;
    AttachmentInfo depthAttachmentInfo;
    
    // Otimizações avançadas
    private long imagelessFramebuffer = VK_NULL_HANDLE;
    private boolean useOptimizedSubpasses = false;
    private boolean supportsRenderPass2 = false;
    private boolean supportsImagelessFramebuffer = false;

    public RenderPass(Framebuffer framebuffer, AttachmentInfo colorAttachmentInfo, AttachmentInfo depthAttachmentInfo) {
        this.framebuffer = framebuffer;
        this.colorAttachmentInfo = colorAttachmentInfo;
        this.depthAttachmentInfo = depthAttachmentInfo;

        int count = 0;
        if (colorAttachmentInfo != null) count++;
        if (depthAttachmentInfo != null) count++;
        this.attachmentCount = count;

        // Detectar suporte a extensões
        checkExtensionSupport();

        if (!Vulkan.DYNAMIC_RENDERING) {
            if (supportsRenderPass2) {
                createOptimizedRenderPass2();
            } else {
                createRenderPass();
            }
            
            if (supportsImagelessFramebuffer) {
                createImagelessFramebuffer();
            }
        }
    }

    private void checkExtensionSupport() {
        // Verificar se RenderPass2 está disponível
        try {
            supportsRenderPass2 = Vulkan.getDeviceProperties()
                .getApiVersion() >= VK_API_VERSION_1_2 ||
                Vulkan.isExtensionSupported(VK_KHR_CREATE_RENDERPASS_2_EXTENSION_NAME);
        } catch (Exception e) {
            supportsRenderPass2 = false;
        }

        // Verificar se Imageless Framebuffer está disponível
        try {
            supportsImagelessFramebuffer = Vulkan.getDeviceProperties()
                .getApiVersion() >= VK_API_VERSION_1_2 ||
                Vulkan.isExtensionSupported(VK_KHR_IMAGELESS_FRAMEBUFFER_EXTENSION_NAME);
        } catch (Exception e) {
            supportsImagelessFramebuffer = false;
        }
    }

    // ========================================================================
    // RENDER PASS 2 OTIMIZADO (VK_KHR_create_renderpass2)
    // ========================================================================
    private void createOptimizedRenderPass2() {
        try (MemoryStack stack = MemoryStack.stackPush()) {
            // Determinar número de attachments baseado na configuração
            int totalAttachments = 0;
            if (colorAttachmentInfo != null) totalAttachments += 2; // MSAA + Resolved
            if (depthAttachmentInfo != null) totalAttachments += 2; // MSAA + Resolved
            
            VkAttachmentDescription2.Buffer attachments = VkAttachmentDescription2.calloc(totalAttachments, stack);
            
            int attachmentIndex = 0;
            
            // ====================================================================
            // ATTACHMENT 0: Color MSAA (Transient)
            // ====================================================================
            if (colorAttachmentInfo != null) {
                VkAttachmentDescription2 colorMsaa = attachments.get(attachmentIndex++);
                colorMsaa.sType$Default()
                    .format(colorAttachmentInfo.format)
                    .samples(VK_SAMPLE_COUNT_4_BIT) // MSAA 4x
                    .loadOp(VK_ATTACHMENT_LOAD_OP_CLEAR)
                    .storeOp(VK_ATTACHMENT_STORE_OP_DONT_CARE) // Transient!
                    .stencilLoadOp(VK_ATTACHMENT_LOAD_OP_DONT_CARE)
                    .stencilStoreOp(VK_ATTACHMENT_STORE_OP_DONT_CARE)
                    .initialLayout(VK_IMAGE_LAYOUT_UNDEFINED)
                    .finalLayout(VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
                
                // Attachment 1: Color Resolved (Input Attachment para lighting)
                VkAttachmentDescription2 colorResolved = attachments.get(attachmentIndex++);
                colorResolved.sType$Default()
                    .format(colorAttachmentInfo.format)
                    .samples(VK_SAMPLE_COUNT_1_BIT)
                    .loadOp(VK_ATTACHMENT_LOAD_OP_DONT_CARE)
                    .storeOp(VK_ATTACHMENT_STORE_OP_STORE)
                    .stencilLoadOp(VK_ATTACHMENT_LOAD_OP_DONT_CARE)
                    .stencilStoreOp(VK_ATTACHMENT_STORE_OP_DONT_CARE)
                    .initialLayout(VK_IMAGE_LAYOUT_UNDEFINED)
                    .finalLayout(VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
            }
            
            // ====================================================================
            // ATTACHMENT 2: Depth MSAA (Transient)
            // ====================================================================
            if (depthAttachmentInfo != null) {
                VkAttachmentDescription2 depthMsaa = attachments.get(attachmentIndex++);
                depthMsaa.sType$Default()
                    .format(depthAttachmentInfo.format)
                    .samples(VK_SAMPLE_COUNT_4_BIT) // MSAA 4x
                    .loadOp(VK_ATTACHMENT_LOAD_OP_CLEAR)
                    .storeOp(VK_ATTACHMENT_STORE_OP_DONT_CARE) // Transient!
                    .stencilLoadOp(VK_ATTACHMENT_LOAD_OP_DONT_CARE)
                    .stencilStoreOp(VK_ATTACHMENT_STORE_OP_DONT_CARE)
                    .initialLayout(VK_IMAGE_LAYOUT_UNDEFINED)
                    .finalLayout(VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL);
                
                // Attachment 3: Depth Resolved (Input Attachment)
                VkAttachmentDescription2 depthResolved = attachments.get(attachmentIndex++);
                depthResolved.sType$Default()
                    .format(depthAttachmentInfo.format)
                    .samples(VK_SAMPLE_COUNT_1_BIT)
                    .loadOp(VK_ATTACHMENT_LOAD_OP_DONT_CARE)
                    .storeOp(VK_ATTACHMENT_STORE_OP_STORE)
                    .stencilLoadOp(VK_ATTACHMENT_LOAD_OP_DONT_CARE)
                    .stencilStoreOp(VK_ATTACHMENT_STORE_OP_DONT_CARE)
                    .initialLayout(VK_IMAGE_LAYOUT_UNDEFINED)
                    .finalLayout(VK_IMAGE_LAYOUT_DEPTH_STENCIL_READ_ONLY_OPTIMAL);
            }
            
            // ====================================================================
            // SUBPASS 0: Geometry (MSAA → Resolve)
            // ====================================================================
            VkSubpassDescription2.Buffer subpasses = VkSubpassDescription2.calloc(1, stack);
            VkSubpassDescription2 subpass0 = subpasses.get(0);
            subpass0.sType$Default()
                .pipelineBindPoint(VK_PIPELINE_BIND_POINT_GRAPHICS);
            
            // Color attachments do subpass 0
            if (colorAttachmentInfo != null) {
                VkAttachmentReference2.Buffer colorRefs = VkAttachmentReference2.calloc(1, stack);
                colorRefs.get(0)
                    .sType$Default()
                    .attachment(0) // Color MSAA
                    .layout(VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL)
                    .aspectMask(VK_IMAGE_ASPECT_COLOR_BIT);
                
                subpass0.colorAttachmentCount(1)
                    .pColorAttachments(colorRefs);
                
                // Resolve attachment (MSAA → 1x)
                VkAttachmentReference2.Buffer resolveRefs = VkAttachmentReference2.calloc(1, stack);
                resolveRefs.get(0)
                    .sType$Default()
                    .attachment(1) // Color Resolved
                    .layout(VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL)
                    .aspectMask(VK_IMAGE_ASPECT_COLOR_BIT);
                
                subpass0.pResolveAttachments(resolveRefs);
            }
            
            // Depth attachment do subpass 0
            if (depthAttachmentInfo != null) {
                VkAttachmentReference2 depthRef = VkAttachmentReference2.calloc(stack);
                depthRef.sType$Default()
                    .attachment(colorAttachmentInfo != null ? 2 : 0) // Depth MSAA
                    .layout(VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL)
                    .aspectMask(VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT);
                
                subpass0.pDepthStencilAttachment(depthRef);
                
                // Depth resolve via VK_KHR_depth_stencil_resolve
                VkAttachmentReference2 depthResolveRef = VkAttachmentReference2.calloc(stack);
                depthResolveRef.sType$Default()
                    .attachment(colorAttachmentInfo != null ? 3 : 1) // Depth Resolved
                    .layout(VK_IMAGE_LAYOUT_DEPTH_STENCIL_READ_ONLY_OPTIMAL)
                    .aspectMask(VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT);
                
                VkSubpassDescriptionDepthStencilResolve depthResolve = VkSubpassDescriptionDepthStencilResolve.calloc(stack);
                depthResolve.sType$Default()
                    .depthResolveMode(VK_RESOLVE_MODE_SAMPLE_ZERO_BIT)
                    .stencilResolveMode(VK_RESOLVE_MODE_SAMPLE_ZERO_BIT)
                    .pDepthStencilResolveAttachment(depthResolveRef);
                
                subpass0.pNext(depthResolve.address());
            }
            
            // ====================================================================
            // SUBPASS DEPENDENCIES (OTIMIZADAS COM BY_REGION_BIT)
            // ====================================================================
            VkSubpassDependency2.Buffer dependencies = VkSubpassDependency2.calloc(2, stack);
            
            // Dependency 1: External → Subpass 0
            dependencies.get(0)
                .sType$Default()
                .srcSubpass(VK_SUBPASS_EXTERNAL)
                .dstSubpass(0)
                .srcStageMask(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT)
                .dstStageMask(VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | 
                             VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT)
                .srcAccessMask(VK_ACCESS_MEMORY_READ_BIT)
                .dstAccessMask(VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | 
                              VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT)
                .dependencyFlags(VK_DEPENDENCY_BY_REGION_BIT) // CRÍTICO PARA MALI!
                .viewOffset(0);
            
            // Dependency 2: Subpass 0 → External
            dependencies.get(1)
                .sType$Default()
                .srcSubpass(0)
                .dstSubpass(VK_SUBPASS_EXTERNAL)
                .srcStageMask(VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | 
                             VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT)
                .dstStageMask(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT)
                .srcAccessMask(VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | 
                              VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT)
                .dstAccessMask(VK_ACCESS_MEMORY_READ_BIT)
                .dependencyFlags(VK_DEPENDENCY_BY_REGION_BIT) // CRÍTICO PARA MALI!
                .viewOffset(0);
            
            // ====================================================================
            // CREATE RENDER PASS 2
            // ====================================================================
            VkRenderPassCreateInfo2 renderPassInfo = VkRenderPassCreateInfo2.calloc(stack);
            renderPassInfo.sType$Default()
                .attachmentCount(attachments.remaining())
                .pAttachments(attachments)
                .subpassCount(subpasses.remaining())
                .pSubpasses(subpasses)
                .dependencyCount(dependencies.remaining())
                .pDependencies(dependencies)
                .correlatedViewMaskCount(0)
                .pCorrelatedViewMasks(null);
            
            LongBuffer pRenderPass = stack.mallocLong(1);
            
            if (vkCreateRenderPass2(Vulkan.getVkDevice(), renderPassInfo, null, pRenderPass) != VK_SUCCESS) {
                throw new RuntimeException("Failed to create optimized render pass 2");
            }
            
            id = pRenderPass.get(0);
            useOptimizedSubpasses = true;
        }
    }

    // ========================================================================
    // RENDER PASS TRADICIONAL (FALLBACK PARA VULKAN 1.0)
    // ========================================================================
    private void createRenderPass() {
        try (MemoryStack stack = MemoryStack.stackPush()) {
            VkAttachmentDescription.Buffer attachments = VkAttachmentDescription.calloc(attachmentCount, stack);
            VkAttachmentReference.Buffer attachmentRefs = VkAttachmentReference.calloc(attachmentCount, stack);

            VkSubpassDescription.Buffer subpass = VkSubpassDescription.calloc(1, stack);
            subpass.pipelineBindPoint(VK_PIPELINE_BIND_POINT_GRAPHICS);

            int i = 0;

            // Color attachment
            if (colorAttachmentInfo != null) {
                VkAttachmentDescription colorAttachment = attachments.get(i);
                colorAttachment.format(colorAttachmentInfo.format)
                    .samples(VK_SAMPLE_COUNT_1_BIT)
                    .loadOp(colorAttachmentInfo.loadOp)
                    .storeOp(colorAttachmentInfo.storeOp)
                    .stencilLoadOp(VK_ATTACHMENT_LOAD_OP_DONT_CARE)
                    .stencilStoreOp(VK_ATTACHMENT_STORE_OP_DONT_CARE)
                    .initialLayout(VK_IMAGE_LAYOUT_UNDEFINED)
                    .finalLayout(colorAttachmentInfo.finalLayout);

                VkAttachmentReference colorAttachmentRef = attachmentRefs.get(i)
                    .attachment(i)
                    .layout(VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);

                subpass.colorAttachmentCount(1);
                subpass.pColorAttachments(VkAttachmentReference.calloc(1, stack).put(0, colorAttachmentRef));

                ++i;
            }

            // Depth-Stencil attachment
            if (depthAttachmentInfo != null) {
                VkAttachmentDescription depthAttachment = attachments.get(i);
                depthAttachment.format(depthAttachmentInfo.format)
                    .samples(VK_SAMPLE_COUNT_1_BIT)
                    .loadOp(depthAttachmentInfo.loadOp)
                    .storeOp(depthAttachmentInfo.storeOp)
                    .stencilLoadOp(VK_ATTACHMENT_LOAD_OP_DONT_CARE)
                    .stencilStoreOp(VK_ATTACHMENT_STORE_OP_DONT_CARE)
                    .initialLayout(VK_IMAGE_LAYOUT_UNDEFINED)
                    .finalLayout(depthAttachmentInfo.finalLayout);

                VkAttachmentReference depthAttachmentRef = attachmentRefs.get(i)
                    .attachment(i)
                    .layout(VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL);

                subpass.pDepthStencilAttachment(depthAttachmentRef);
            }

            VkRenderPassCreateInfo renderPassInfo = VkRenderPassCreateInfo.calloc(stack);
            renderPassInfo.sType$Default()
                .pAttachments(attachments)
                .pSubpasses(subpass);

            // Layout transition subpass dependency (CORRIGIDA)
            VkSubpassDependency.Buffer subpassDependencies = VkSubpassDependency.calloc(2, stack);
            
            // Dependency 1: External → Subpass 0
            subpassDependencies.get(0)
                .srcSubpass(VK_SUBPASS_EXTERNAL)
                .dstSubpass(0)
                .srcStageMask(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT)
                .dstStageMask(VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | 
                             VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT)
                .srcAccessMask(VK_ACCESS_MEMORY_READ_BIT)
                .dstAccessMask(VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | 
                              VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT)
                .dependencyFlags(VK_DEPENDENCY_BY_REGION_BIT); // ADICIONADO!
            
            // Dependency 2: Subpass 0 → External
            subpassDependencies.get(1)
                .srcSubpass(0)
                .dstSubpass(VK_SUBPASS_EXTERNAL)
                .srcStageMask(VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | 
                             VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT)
                .dstStageMask(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT)
                .srcAccessMask(VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | 
                              VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT)
                .dstAccessMask(VK_ACCESS_MEMORY_READ_BIT)
                .dependencyFlags(VK_DEPENDENCY_BY_REGION_BIT); // ADICIONADO!

            renderPassInfo.pDependencies(subpassDependencies);

            LongBuffer pRenderPass = stack.mallocLong(1);

            if (vkCreateRenderPass(Vulkan.getVkDevice(), renderPassInfo, null, pRenderPass) != VK_SUCCESS) {
                throw new RuntimeException("Failed to create render pass");
            }

            id = pRenderPass.get(0);
        }
    }

    // ========================================================================
    // IMAGELESS FRAMEBUFFER (VK_KHR_imageless_framebuffer)
    // ========================================================================
    private void createImagelessFramebuffer() {
        try (MemoryStack stack = MemoryStack.stackPush()) {
            // Preparar informações de attachments
            int attachmentCount = 0;
            if (colorAttachmentInfo != null) attachmentCount += 2; // MSAA + Resolved
            if (depthAttachmentInfo != null) attachmentCount += 2; // MSAA + Resolved
            
            VkFramebufferAttachmentImageInfo.Buffer attachmentInfos = 
                VkFramebufferAttachmentImageInfo.calloc(attachmentCount, stack);
            
            int idx = 0;
            
            if (colorAttachmentInfo != null) {
                // Color MSAA
                attachmentInfos.get(idx++)
                    .sType$Default()
                    .flags(0)
                    .usage(VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT)
                    .width(framebuffer.getWidth())
                    .height(framebuffer.getHeight())
                    .layerCount(1)
                    .viewFormatCount(1)
                    .pViewFormats(stack.ints(colorAttachmentInfo.format));
                
                // Color Resolved
                attachmentInfos.get(idx++)
                    .sType$Default()
                    .flags(0)
                    .usage(VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT)
                    .width(framebuffer.getWidth())
                    .height(framebuffer.getHeight())
                    .layerCount(1)
                    .viewFormatCount(1)
                    .pViewFormats(stack.ints(colorAttachmentInfo.format));
            }
            
            if (depthAttachmentInfo != null) {
                // Depth MSAA
                attachmentInfos.get(idx++)
                    .sType$Default()
                    .flags(0)
                    .usage(VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT)
                    .width(framebuffer.getWidth())
                    .height(framebuffer.getHeight())
                    .layerCount(1)
                    .viewFormatCount(1)
                    .pViewFormats(stack.ints(depthAttachmentInfo.format));
                
                // Depth Resolved
                attachmentInfos.get(idx++)
                    .sType$Default()
                    .flags(0)
                    .usage(VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT | VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT)
                    .width(framebuffer.getWidth())
                    .height(framebuffer.getHeight())
                    .layerCount(1)
                    .viewFormatCount(1)
                    .pViewFormats(stack.ints(depthAttachmentInfo.format));
            }
            
            VkFramebufferAttachmentsCreateInfo attachmentsCreateInfo = 
                VkFramebufferAttachmentsCreateInfo.calloc(stack);
            attachmentsCreateInfo.sType$Default()
                .attachmentImageInfoCount(attachmentInfos.remaining())
                .pAttachmentImageInfos(attachmentInfos);
            
            VkFramebufferCreateInfo framebufferInfo = VkFramebufferCreateInfo.calloc(stack);
            framebufferInfo.sType$Default()
                .pNext(attachmentsCreateInfo.address())
                .flags(VK_FRAMEBUFFER_CREATE_IMAGELESS_BIT) // MÁGICA!
                .renderPass(id)
                .attachmentCount(attachmentCount)
                .pAttachments(null) // VAZIO! Views vêm no beginRenderPass
                .width(framebuffer.getWidth())
                .height(framebuffer.getHeight())
                .layers(1);
            
            LongBuffer pFramebuffer = stack.mallocLong(1);
            
            if (vkCreateFramebuffer(Vulkan.getVkDevice(), framebufferInfo, null, pFramebuffer) != VK_SUCCESS) {
                throw new RuntimeException("Failed to create imageless framebuffer");
            }
            
            imagelessFramebuffer = pFramebuffer.get(0);
        }
    }

    // ========================================================================
    // BEGIN RENDER PASS (OTIMIZADO)
    // ========================================================================
    public void beginRenderPass(VkCommandBuffer commandBuffer, long framebufferId, MemoryStack stack) {
        // Se usando imageless framebuffer, precisamos fornecer as views
        if (supportsImagelessFramebuffer && imagelessFramebuffer != VK_NULL_HANDLE) {
            beginRenderPassImageless(commandBuffer, stack);
        } else {
            beginRenderPassTraditional(commandBuffer, framebufferId, stack);
        }
        
        Renderer.getInstance().setBoundRenderPass(this);
    }
    
    private void beginRenderPassImageless(VkCommandBuffer commandBuffer, MemoryStack stack) {
        // Preparar image views dinâmicas
        int viewCount = 0;
        if (colorAttachmentInfo != null) viewCount += 2;
        if (depthAttachmentInfo != null) viewCount += 2;
        
        LongBuffer views = stack.mallocLong(viewCount);
        int idx = 0;
        
        if (colorAttachmentInfo != null) {
            views.put(idx++, framebuffer.getColorAttachmentView());
            views.put(idx++, framebuffer.getColorResolvedView()); // Você precisa adicionar este método
        }
        
        if (depthAttachmentInfo != null) {
            views.put(idx++, framebuffer.getDepthAttachmentView());
            views.put(idx++, framebuffer.getDepthResolvedView()); // Você precisa adicionar este método
        }
        
        views.flip();
        
        VkRenderPassAttachmentBeginInfo attachmentBeginInfo = VkRenderPassAttachmentBeginInfo.calloc(stack);
        attachmentBeginInfo.sType$Default()
            .attachmentCount(views.remaining())
            .pAttachments(views);
        
        VkRenderPassBeginInfo renderPassInfo = VkRenderPassBeginInfo.calloc(stack);
        renderPassInfo.sType$Default()
            .pNext(attachmentBeginInfo.address())
            .renderPass(id)
            .framebuffer(imagelessFramebuffer);
        
        VkRect2D renderArea = VkRect2D.malloc(stack);
        renderArea.offset().set(0, 0);
        renderArea.extent().set(framebuffer.getWidth(), framebuffer.getHeight());
        renderPassInfo.renderArea(renderArea);
        
        VkClearValue.Buffer clearValues = VkClearValue.malloc(2, stack);
        clearValues.get(0).color().float32(VRenderSystem.clearColor);
        clearValues.get(1).depthStencil().set(1.0f, 0);
        
        renderPassInfo.pClearValues(clearValues);
        
        vkCmdBeginRenderPass(commandBuffer, renderPassInfo, VK_SUBPASS_CONTENTS_INLINE);
    }
    
    private void beginRenderPassTraditional(VkCommandBuffer commandBuffer, long framebufferId, MemoryStack stack) {
        // Transições de layout automáticas via initialLayout/finalLayout
        // NÃO precisa fazer transition manual!
        
        VkRenderPassBeginInfo renderPassInfo = VkRenderPassBeginInfo.calloc(stack);
        renderPassInfo.sType$Default()
            .renderPass(id)
            .framebuffer(framebufferId);
        
        VkRect2D renderArea = VkRect2D.malloc(stack);
        renderArea.offset().set(0, 0);
        renderArea.extent().set(framebuffer.getWidth(), framebuffer.getHeight());
        renderPassInfo.renderArea(renderArea);
        
        VkClearValue.Buffer clearValues = VkClearValue.malloc(2, stack);
        clearValues.get(0).color().float32(VRenderSystem.clearColor);
        clearValues.get(1).depthStencil().set(1.0f, 0);
        
        renderPassInfo.pClearValues(clearValues);
        
        vkCmdBeginRenderPass(commandBuffer, renderPassInfo, VK_SUBPASS_CONTENTS_INLINE);
    }

    // ========================================================================
    // END RENDER PASS
    // ========================================================================
    public void endRenderPass(VkCommandBuffer commandBuffer) {
        if (Vulkan.DYNAMIC_RENDERING) {
            KHRDynamicRendering.vkCmdEndRenderingKHR(commandBuffer);

            try (MemoryStack stack = MemoryStack.stackPush()) {
                if (colorAttachmentInfo != null
                    && framebuffer.getColorAttachment().getCurrentLayout() != colorAttachmentInfo.finalLayout) {
                    framebuffer.getColorAttachment()
                        .transitionImageLayout(stack, commandBuffer, colorAttachmentInfo.finalLayout);
                }
                if (depthAttachmentInfo != null
                    && framebuffer.getDepthAttachment().getCurrentLayout() != depthAttachmentInfo.finalLayout) {
                    framebuffer.getDepthAttachment()
                        .transitionImageLayout(stack, commandBuffer, depthAttachmentInfo.finalLayout);
                }
            }
        } else {
            vkCmdEndRenderPass(commandBuffer);

            if (colorAttachmentInfo != null)
                framebuffer.getColorAttachment().setCurrentLayout(colorAttachmentInfo.finalLayout);

            if (depthAttachmentInfo != null)
                framebuffer.getDepthAttachment().setCurrentLayout(depthAttachmentInfo.finalLayout);
        }

        Renderer.getInstance().setBoundRenderPass(null);
    }

    // ========================================================================
    // DYNAMIC RENDERING (MANTIDO PARA COMPATIBILIDADE)
    // ========================================================================
    public void beginDynamicRendering(VkCommandBuffer commandBuffer, MemoryStack stack) {
        if (colorAttachmentInfo != null
            && framebuffer.getColorAttachment().getCurrentLayout() != VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL) {
            framebuffer.getColorAttachment()
                .transitionImageLayout(stack, commandBuffer, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
        }
        if (depthAttachmentInfo != null
            && framebuffer.getDepthAttachment().getCurrentLayout() != VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL) {
            framebuffer.getDepthAttachment()
                .transitionImageLayout(stack, commandBuffer, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL);
        }

        VkRect2D renderArea = VkRect2D.malloc(stack);
        renderArea.offset().set(0, 0);
        renderArea.extent().set(framebuffer.getWidth(), framebuffer.getHeight());

        VkClearValue.Buffer clearValues = VkClearValue.malloc(2, stack);
        clearValues.get(0).color().float32(VRenderSystem.clearColor);
        clearValues.get(1).depthStencil().set(1.0f, 0);

        VkRenderingInfo renderingInfo = VkRenderingInfo.calloc(stack);
        renderingInfo.sType(KHRDynamicRendering.VK_STRUCTURE_TYPE_RENDERING_INFO_KHR);
        renderingInfo.renderArea(renderArea);
        renderingInfo.layerCount(1);

        if (colorAttachmentInfo != null) {
            VkRenderingAttachmentInfo.Buffer colorAttachment = VkRenderingAttachmentInfo.calloc(1, stack);
            colorAttachment.sType(KHRDynamicRendering.VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO_KHR);
            colorAttachment.imageView(framebuffer.getColorAttachmentView());
            colorAttachment.imageLayout(VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
            colorAttachment.loadOp(colorAttachmentInfo.loadOp);
            colorAttachment.storeOp(colorAttachmentInfo.storeOp);
            colorAttachment.clearValue(clearValues.get(0));

            renderingInfo.pColorAttachments(colorAttachment);
        }

        if (depthAttachmentInfo != null) {
            VkRenderingAttachmentInfo depthAttachment = VkRenderingAttachmentInfo.calloc(stack);
            depthAttachment.sType(KHRDynamicRendering.VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO_KHR);
            depthAttachment.imageView(framebuffer.getDepthImageView());
            depthAttachment.imageLayout(VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL);
            depthAttachment.loadOp(depthAttachmentInfo.loadOp);
            depthAttachment.storeOp(depthAttachmentInfo.storeOp);
            depthAttachment.clearValue(clearValues.get(1));

            renderingInfo.pDepthAttachment(depthAttachment);
        }

        KHRDynamicRendering.vkCmdBeginRenderingKHR(commandBuffer, renderingInfo);
    }

    // ========================================================================
    // CLEANUP
    // ========================================================================
    public void cleanUp() {
        if (!Vulkan.DYNAMIC_RENDERING) {
            MemoryManager.getInstance().addFrameOp(() -> {
                if (id != VK_NULL_HANDLE) {
                    vkDestroyRenderPass(Vulkan.getVkDevice(), id, null);
                    id = VK_NULL_HANDLE;
                }
                if (imagelessFramebuffer != VK_NULL_HANDLE) {
                    vkDestroyFramebuffer(Vulkan.getVkDevice(), imagelessFramebuffer, null);
                    imagelessFramebuffer = VK_NULL_HANDLE;
                }
            });
        }
    }

    // ========================================================================
    // GETTERS/SETTERS
    // ========================================================================
    public Framebuffer getFramebuffer() {
        return framebuffer;
    }

    public void setFramebuffer(Framebuffer framebuffer) {
        this.framebuffer = framebuffer;
    }

    public long getId() {
        return id;
    }

    public long getImagelessFramebufferId() {
        return imagelessFramebuffer;
    }

    public boolean isUsingOptimizedSubpasses() {
        return useOptimizedSubpasses;
    }

    // ========================================================================
    // ATTACHMENT INFO (MANTIDO)
    // ========================================================================
    public static class AttachmentInfo {
        final Type type;
        final int format;
        int finalLayout;
        int loadOp;
        int storeOp;

        public AttachmentInfo(Type type, int format) {
            this.type = type;
            this.format = format;
            this.finalLayout = type.defaultLayout;
            this.loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
            this.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
        }

        public AttachmentInfo setOps(int loadOp, int storeOp) {
            this.loadOp = loadOp;
            this.storeOp = storeOp;
            return this;
        }

        public AttachmentInfo setLoadOp(int loadOp) {
            this.loadOp = loadOp;
            return this;
        }

        public AttachmentInfo setFinalLayout(int finalLayout) {
            this.finalLayout = finalLayout;
            return this;
        }

        public enum Type {
            COLOR(VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL),
            DEPTH(VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL);

            final int defaultLayout;

            Type(int layout) {
                defaultLayout = layout;
            }
        }
    }

    // ========================================================================
    // BUILDER (MANTIDO)
    // ========================================================================
    public static Builder builder(Framebuffer framebuffer) {
        return new Builder(framebuffer);
    }

    public static class Builder {
        Framebuffer framebuffer;
        AttachmentInfo colorAttachmentInfo;
        AttachmentInfo depthAttachmentInfo;

        public Builder(Framebuffer framebuffer) {
            this.framebuffer = framebuffer;

            if (framebuffer.hasColorAttachment)
                colorAttachmentInfo = new AttachmentInfo(AttachmentInfo.Type.COLOR, framebuffer.format)
                    .setOps(VK_ATTACHMENT_LOAD_OP_CLEAR, VK_ATTACHMENT_STORE_OP_STORE);
            if (framebuffer.hasDepthAttachment)
                depthAttachmentInfo = new AttachmentInfo(AttachmentInfo.Type.DEPTH, framebuffer.depthFormat)
                    .setOps(VK_ATTACHMENT_LOAD_OP_CLEAR, VK_ATTACHMENT_STORE_OP_DONT_CARE);
        }

        public RenderPass build() {
            return new RenderPass(framebuffer, colorAttachmentInfo, depthAttachmentInfo);
        }

        public Builder setLoadOp(int loadOp) {
            if (colorAttachmentInfo != null) {
                colorAttachmentInfo.setLoadOp(loadOp);
            }
            if (depthAttachmentInfo != null) {
                depthAttachmentInfo.setLoadOp(loadOp);
            }
            return this;
        }

        public AttachmentInfo getColorAttachmentInfo() {
            return colorAttachmentInfo;
        }

        public AttachmentInfo getDepthAttachmentInfo() {
            return depthAttachmentInfo;
        }
    }
}
